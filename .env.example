# =============================================================================
# Life Agent — environment template
# Copy to .env and adjust. NEVER put real production secrets in this file or Git.
# Production secrets live in the macOS Keychain on the Backend MacBook.
# =============================================================================

# --- Runtime mode -----------------------------------------------------------
# demo | readonly_personal | controlled_action
# Development defaults to `demo`. Real integrations require an intentional change.
LIFE_AGENT_MODE=demo

# development | testing | staging | production
LIFE_AGENT_ENV=development

# --- Execution reality boundary (Section 35) --------------------------------
# simulation | production
# The Development Mac MUST stay `simulation`: mocked sources, no real side effects.
# Only the Backend Mac (with LIFE_AGENT_ENV=production) may set `production`, which
# permits real, approval-gated side effects. Config guardrails reject illegal combos.
LIFE_AGENT_EXECUTION_MODE=simulation

# --- API --------------------------------------------------------------------
LIFE_AGENT_API_HOST=127.0.0.1
LIFE_AGENT_API_PORT=8787
# Comma-separated list of allowed CORS origins (empty = none).
LIFE_AGENT_CORS_ORIGINS=

# --- Database ---------------------------------------------------------------
# SQLite for the prototype; abstractions allow a Postgres URL in production, e.g.
# postgresql+psycopg://lifeagent:CHANGE_ME@127.0.0.1:5432/lifeagent
LIFE_AGENT_DATABASE_URL=sqlite:///./data/lifeagent_dev.db

# --- Data directories (configurable; never hard-coded paths) ----------------
LIFE_AGENT_DATA_DIR=./data
LIFE_AGENT_DOCUMENTS_DIR=./data/documents
LIFE_AGENT_LOG_DIR=./logs

# --- Autonomy ---------------------------------------------------------------
# 0=observe, 1=prepare, 2=low-risk automation, 3=trusted workflows.
# Level 4 (consequential) is never fully autonomous. Default is 1 (prepare).
LIFE_AGENT_DEFAULT_AUTONOMY_LEVEL=1

# --- Autonomous runtime (Section 35; Backend Mac only) ----------------------
# The continuous intelligence loop runs only in production execution. These tune
# its cadence and safety; leave disabled on the Development Mac.
LIFE_AGENT_AUTONOMY_LOOP_ENABLED=false
LIFE_AGENT_AUTONOMY_LOOP_INTERVAL_SECONDS=30
LIFE_AGENT_AUTONOMY_MAX_EVENTS_PER_TICK=25
# Proactive user notifications (a real side effect; gated by the execution boundary).
LIFE_AGENT_NOTIFICATIONS_ENABLED=false

# --- Feature flags (all real-world side effects OFF by default) -------------
LIFE_AGENT_FEATURE_REAL_EMAIL_SEND=false
LIFE_AGENT_FEATURE_REAL_EMAIL_SYNC=false
LIFE_AGENT_FEATURE_REAL_CALENDAR_WRITE=false
LIFE_AGENT_FEATURE_MOVE_EMAIL_TO_SPAM=false
LIFE_AGENT_FEATURE_REMOTE_AI_FALLBACK=false

# --- Local AI model routing -------------------------------------------------
# Provider: mock | ollama | openai_compatible | mlx
# Development defaults to `mock` so the app is fully runnable with no model server.
LIFE_AGENT_LLM_PROVIDER=mock
# Only used by ollama / openai_compatible providers.
LIFE_AGENT_LLM_BASE_URL=http://127.0.0.1:11434
# Model profile names — NOT hard-coded model names in code.
LIFE_AGENT_MODEL_REASONING=development-full
LIFE_AGENT_MODEL_FAST=development-fast
LIFE_AGENT_MODEL_EMBEDDING=production-embedding
# Remote fallback key (disabled by default; leave empty in Git).
LIFE_AGENT_REMOTE_AI_API_KEY=

# --- Security / auth --------------------------------------------------------
# Dev-only shared token for the API. In production, per-device paired credentials
# are minted by the backend and stored in the iOS Keychain — never in this file.
LIFE_AGENT_DEV_API_TOKEN=dev-only-change-me
# Master key used to derive at-rest encryption. Production value lives in Keychain.
LIFE_AGENT_MASTER_KEY=dev-only-not-secret

# --- Integrations (mock by default) ----------------------------------------
# Gmail OAuth client id/secret are configured ON THE BACKEND MAC only.
# Never place production OAuth refresh tokens here.
LIFE_AGENT_GMAIL_CLIENT_ID=
LIFE_AGENT_GMAIL_CLIENT_SECRET=
